<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Primary capture is the notification listener (no restricted permission, works on a
         sideloaded install). RECEIVE_SMS only powers the fallback broadcast path, which fires
         when the permission is actually held (adb install / default-SMS app). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Sending is only reachable once the app is the default SMS app (which exempts it from
         the hard SMS-permission restriction); the outbox is polled and sent from there. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Maps a chosen SIM slot to its subscription when sending on a dual-SIM phone. Without it
         an explicitly chosen SIM is refused (rather than silently sent on the other card). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Reading the system SMS database: the 已有短信 backfill and the system half of sync-delete.
         Hard-restricted like SEND_SMS, so it is only ever granted alongside the default-SMS role;
         on a phone that never holds the role it simply stays denied and those two features report
         that instead of failing silently. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-app updater: launch the system package installer for the downloaded APK. The install
         itself still needs the user's explicit tap — this only lets the app start that flow. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only used to tell you that syncing broke; never to show SMS contents. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app pop the one-tap "ignore battery optimizations" dialog, so the listener
         isn't killed in Doze. Restricted on Play, fine for a sideloaded personal app. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The keep-alive foreground service (ForwardService) hosts the outbox poller + heartbeat.
         specialUse is the only type with no daily runtime cap and still startable from boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Restart the service after a reboot / app update, so forwarding never silently stops. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The poll alarm has to wake a sleeping phone on time; without an exact alarm the system
         gives it a 45s window and a web-sent SMS waits a minute. Degrades gracefully when 33+
         withholds it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 11+ package visibility. Needed so the notification listener can ask the system
         which packages are SMS apps (they declare an SMS_DELIVER receiver) instead of trusting the
         legacy default-SMS setting, which this ROM leaves stale.
         The narrow <queries><intent action=SMS_DELIVER/></queries> form was tried first and
         MEASURED not to work: on an Android 11 device queryBroadcastReceivers still came back with
         only our own receiver (raw=1), and returned the real SMS app (raw=2) only once this
         permission was held — intent-based visibility does not cover broadcast receivers. Do not
         "tighten" this back to <queries> without re-measuring.
         Play restricts this permission; irrelevant here — the app is sideloaded, and it already
         reads every notification on the phone, which is far more than knowing what is installed. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:label="验证码"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- Serves the downloaded update APK to the package installer via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keep-alive host: foreground service running the outbox poller + heartbeat. Not
             exported; started by MainActivity, BootReceiver, CodeListener, and START_STICKY. -->
        <service
            android:name=".ForwardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="personal SMS forwarder: polls an encrypted outbox and heartbeats" />
        </service>

        <!-- Restarts ForwardService after reboot or an app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Reads incoming-SMS notifications. The BIND permission is held by the system, and the
             user turns this on under Settings → Notification access. -->
        <service
            android:name=".CodeListener"
            android:exported="true"
            android:label="验证码"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- SMS capture. SMS_RECEIVED reaches every RECEIVE_SMS holder; SMS_DELIVER reaches only
             the default SMS app. Both funnel into forwardNow, which dedups. -->
        <receiver
            android:name=".IncomingReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- The remaining three components exist only to make the app eligible as the default
             SMS app; on a dedicated forwarding phone they are stubs that do nothing. -->
        <receiver
            android:name=".MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <activity android:name=".ComposeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
    </application>
</manifest>
